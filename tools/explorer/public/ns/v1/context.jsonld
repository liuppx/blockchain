{
  "@context": {
    "@version": 1.1,
    "kdg": "https://blockchain.yeying.pub/ns/v1#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "type": "@type",

    "KnowledgeUnit": "kdg:KnowledgeUnit",
    "UnitVersion": "kdg:UnitVersion",
    "Verification": "kdg:Verification",
    "Member": "prov:Person",
    "Model": "prov:SoftwareAgent",
    "Generation": "prov:Activity",
    "Body": "schema:MediaObject",
    "ConceptScheme": "skos:ConceptScheme",
    "Concept": "skos:Concept",

    "layer": { "@id": "kdg:layer", "@type": "@id" },
    "domain": { "@id": "kdg:domain", "@type": "@id" },
    "lifecycle": { "@id": "kdg:lifecycle", "@type": "@id" },
    "author": { "@id": "dcterms:creator", "@type": "@id" },
    "createdAtHeight": { "@id": "kdg:createdAtHeight", "@type": "xsd:integer" },
    "license": { "@id": "dcterms:license", "@type": "@id" },
    "versions": { "@id": "kdg:hasVersion", "@container": "@list" },
    "latestVersion": { "@id": "kdg:latestVersion", "@type": "@id" },

    "isVersionOf": { "@id": "dcterms:isVersionOf", "@type": "@id" },
    "versionNumber": { "@id": "schema:version", "@type": "xsd:integer" },
    "publisher": { "@id": "prov:wasAttributedTo", "@type": "@id" },
    "publishedAtHeight": { "@id": "kdg:publishedAtHeight", "@type": "xsd:integer" },
    "sourceType": { "@id": "kdg:sourceType", "@type": "@vocab" },
    "human": "kdg:HumanAuthored",
    "model": "kdg:ModelGenerated",
    "model-verified": "kdg:ModelGeneratedHumanVerified",
    "generatedBy": { "@id": "prov:wasGeneratedBy" },
    "associatedWith": { "@id": "prov:wasAssociatedWith", "@type": "@id" },
    "name": "schema:name",

    "bodies": { "@id": "schema:encoding" },
    "inLanguage": "schema:inLanguage",
    "sha256": "schema:sha256",
    "contentUrl": { "@id": "schema:contentUrl", "@type": "@id" },
    "encodingFormat": "schema:encodingFormat",
    "title": "schema:headline",
    "text": "schema:text",

    "basedOn": { "@id": "kdg:basedOn", "@type": "@id" },
    "seeAlso": { "@id": "rdfs:seeAlso", "@type": "@id" },
    "replaces": { "@id": "dcterms:replaces", "@type": "@id" },

    "verifications": { "@id": "kdg:hasVerification" },
    "verifier": { "@id": "prov:wasAssociatedWith", "@type": "@id" },
    "verified": { "@id": "prov:used", "@type": "@id" },
    "verdict": { "@id": "kdg:verdict", "@type": "@vocab" },
    "pass": "kdg:Pass",
    "needs-revision": "kdg:NeedsRevision",
    "atHeight": { "@id": "kdg:atHeight", "@type": "xsd:integer" },
    "noteHash": "kdg:noteHash",

    "selfCredibility": { "@id": "kdg:selfCredibility", "@type": "xsd:decimal" },
    "effectiveCredibility": { "@id": "kdg:effectiveCredibility", "@type": "xsd:decimal" },
    "bottleneck": { "@id": "kdg:bottleneck", "@type": "@id" },

    "accountNumber": { "@id": "kdg:accountNumber", "@type": "xsd:integer" },
    "pubkey": "kdg:pubkey",

    "prefLabel": { "@id": "skos:prefLabel", "@container": "@language" },
    "definition": { "@id": "skos:definition", "@container": "@language" },
    "notation": "skos:notation",
    "inScheme": { "@id": "skos:inScheme", "@type": "@id" },
    "hasTopConcept": { "@id": "skos:hasTopConcept", "@type": "@id" },
    "concepts": { "@id": "skos:hasTopConcept", "@type": "@id" },
    "label": { "@id": "rdfs:label", "@container": "@language" },
    "comment": { "@id": "rdfs:comment", "@container": "@language" },
    "subClassOf": { "@id": "rdfs:subClassOf", "@type": "@id" },
    "subPropertyOf": { "@id": "rdfs:subPropertyOf", "@type": "@id" }
  }
}
